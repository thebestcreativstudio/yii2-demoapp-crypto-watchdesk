{
  "name": "thebestcreativstudio/crypto-watchdesk",
  "description": "Crypto watchdesk: CoinGecko snapshots, deltas, volume anomalies, paper portfolio, alerts (Yii2 + Vue + Docker)",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "yiisoft/yii2": "~2.0.49",
    "yiisoft/yii2-httpclient": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "process-timeout": 1800
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ],
  "scripts": {
    "test": "phpunit"
  }
}
