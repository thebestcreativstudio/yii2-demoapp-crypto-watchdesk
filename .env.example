APP_DEBUG=1
COOKIE_VALIDATION_KEY=crypto-watchdesk-change-me

DB_DSN=mysql:host=127.0.0.1;dbname=crypto_watchdesk
DB_USER=root
DB_PASSWORD=

# CoinGecko public API (no Google OAuth). Optional API key for higher limits.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=

# How often worker sleeps between syncs (seconds). 900 = 15 minutes (friendlier to free API).
SYNC_INTERVAL_SECONDS=900

FRONTEND_URL=http://localhost:18100
